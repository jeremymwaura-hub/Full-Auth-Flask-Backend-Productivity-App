# Copy this file to `.env` and replace the values with real, secret values.
# The application still works without a .env file, but never ship default
# secrets to production.

SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Optional: override the default SQLite database (e.g. a Postgres URL in prod)
DATABASE_URL=sqlite:///app.db
